{
  "productName": "Soul Agent Launcher",
  "version": "0.4.2",
  "identifier": "com.soul.agent.launcher",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "devCsp": null
    },
    "windows": [
      {
        "title": "Soul Agent Launcher",
        "width": 960,
        "height": 680,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": false,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../resources/backends/*.zip": "backends/",
      "resources/python/*.exe": "python/"
    },
    "windows": {
      "wix": {
        "upgradeCode": "BB5E1746-3EB5-4382-AFF0-69873C0287DE"
      }
    }
  }
}
